# =============================================================================
#  Variables de entorno — copia este archivo como ".env"
# =============================================================================
#  IMPORTANTE: aquí NUNCA va la clave service_role ni ningún secreto.
#  El frontend es público; la seguridad se basa en las políticas RLS de
#  Supabase, no en ocultar claves.
# =============================================================================

# --- Supabase (obligatorio) --------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# --- Identidad de esta instalación (obligatorio) -----------------------------
# Debe coincidir EXACTAMENTE con businesses.slug en Supabase.
VITE_BUSINESS_SLUG=barberia-demo

# --- Reglas de reserva por defecto (opcional) --------------------------------
# Se usan como respaldo; los valores de la tabla `businesses` tienen prioridad.
VITE_MIN_LEAD_MINUTES=60
VITE_MAX_ADVANCE_DAYS=60

# --- Interfaz (opcional) -----------------------------------------------------
# "false" oculta el enlace al panel en el pie de página público.
VITE_SHOW_ADMIN_LINK=true

# --- Sobrescrituras de contacto (opcional) -----------------------------------
# Solo si quieres forzar estos datos sobre los de la base de datos.
# VITE_BUSINESS_NAME=
# VITE_BUSINESS_PHONE=
# VITE_BUSINESS_WHATSAPP=
# VITE_BUSINESS_ADDRESS=
